<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="6dp"
    android:paddingEnd="10dp"
    android:paddingStart="12dp"
    android:paddingTop="6dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_title"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_pill_tertiary_container"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:text="@string/widget_preview_count"
        android:textColor="@color/widget_on_tertiary_container"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="30dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_pill_surface_variant"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_prev_checklist"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="30dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_pill_surface_variant"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_next_checklist"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
