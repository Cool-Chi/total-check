<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_counter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="6dp"
    android:paddingEnd="10dp"
    android:paddingStart="12dp"
    android:paddingTop="6dp">

    <!-- Dual-Slot Flipper for Smooth < > Transitions -->
    <ViewFlipper
        android:id="@+id/widget_counter_flipper"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:autoStart="false"
        android:inAnimation="@anim/widget_flipper_in"
        android:measureAllChildren="false"
        android:outAnimation="@anim/widget_flipper_out">

        <!-- Slot 0 -->
        <LinearLayout
            android:id="@+id/widget_counter_open_app_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_counter_title_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_counter_reminder_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_counter_count_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_tertiary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_curated_dark_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_curated_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_curated_dark_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_curated_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_curated_light_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_curated_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_curated_light_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_curated_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_dynamic_dark_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_dynamic_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_dynamic_dark_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_dynamic_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_dynamic_light_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_dynamic_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_dynamic_light_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_dynamic_light"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Slot 1 -->
        <LinearLayout
            android:id="@+id/widget_counter_open_app_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_counter_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_counter_reminder_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_counter_count_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_tertiary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_curated_dark_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_curated_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_curated_dark_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_curated_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_curated_light_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_curated_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_curated_light_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_curated_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_dynamic_dark_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_dynamic_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_dynamic_dark_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_dynamic_dark"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_active_dynamic_light_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_active_dynamic_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_counter_progress_done_dynamic_light_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_done_dynamic_light"
                android:visibility="gone" />
        </LinearLayout>
    </ViewFlipper>

    <!-- Right Action Bar (Isolated animateLayoutChanges for ↺ ⇄ 確認?) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:animateLayoutChanges="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_counter_btn_reset"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_reset_icon"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_counter_btn_reset_confirm"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_error_container"
            android:gravity="center"
            android:maxLines="1"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:text="@string/widget_reset_confirm"
            android:textColor="@color/widget_on_error_container"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_counter_btn_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_prev_checklist"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_counter_btn_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_next_checklist"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
