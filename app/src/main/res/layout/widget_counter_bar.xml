<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="6dp"
    android:paddingEnd="10dp"
    android:paddingStart="12dp"
    android:paddingTop="6dp">

    <!-- Dual-Slot Flipper for Smooth < > Transitions -->
    <ViewFlipper
        android:id="@+id/widget_counter_flipper"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:autoStart="false"
        android:inAnimation="@anim/widget_flipper_in"
        android:measureAllChildren="false"
        android:outAnimation="@anim/widget_flipper_out">

        <!-- Slot 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_counter_open_app_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_counter_title_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/widget_counter_wide_info_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/widget_counter_progress_active_0"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_active" />

                    <ProgressBar
                        android:id="@+id/widget_counter_progress_done_0"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/widget_progress_done"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_counter_ratio_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_counter_badge_0"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pill_tertiary_container"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="@color/widget_on_tertiary_container"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slot 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_counter_open_app_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_counter_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/widget_counter_wide_info_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/widget_counter_progress_active_1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_active" />

                    <ProgressBar
                        android:id="@+id/widget_counter_progress_done_1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/widget_progress_done"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_counter_ratio_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_counter_badge_1"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pill_tertiary_container"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="@color/widget_on_tertiary_container"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ViewFlipper>

    <!-- Right Action Bar (Isolated animateLayoutChanges for ↺ ⇄ 確認?) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:animateLayoutChanges="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_counter_btn_reset"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_reset_icon"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_counter_btn_reset_confirm"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_error_container"
            android:gravity="center"
            android:maxLines="1"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:text="@string/widget_reset_confirm"
            android:textColor="@color/widget_on_error_container"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_counter_btn_prev"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_prev_checklist"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_counter_btn_next"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_next_checklist"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
