<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingEnd="12dp"
    android:paddingStart="12dp"
    android:paddingTop="10dp">

    <!-- Simulated Primary Header Row (3x2 Standard Tier) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="32dp"
            android:paddingBottom="2dp"
            android:paddingTop="2dp"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_secondary_container"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingBottom="5dp"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_on_secondary_container"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_reset_icon"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_prev_checklist"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_surface_variant"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_next_checklist"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Simulated Dual-Column Bento Grid (2x2 Dual-State Contrast) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Unchecked Bright Tile + Checked Sunken Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="5dp"
            android:weightSum="2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_surface_high"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/widget_ic_dot_unchecked"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:paddingBottom="7dp"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:singleLine="true"
                android:text="@string/widget_preview_item_1"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_surface_low"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/widget_ic_check_checked"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:paddingBottom="7dp"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:singleLine="true"
                android:text="@string/widget_preview_item_2"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 2: Unchecked Bright Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="5dp"
            android:weightSum="2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_surface_high"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/widget_ic_dot_unchecked"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:paddingBottom="7dp"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:singleLine="true"
                android:text="@string/widget_preview_item_3"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_surface_high"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/widget_ic_dot_unchecked"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:paddingBottom="7dp"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:singleLine="true"
                android:text="@string/widget_preview_item_4"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
